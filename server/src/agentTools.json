            "warm",
            "cool",
            "fresh",
            "autumn",
            "summer",
            "winter",
            "sunset",
            "natural",
            "glowPortrait",
            "soft",
            "smooth",
            "bright",
            "cinema",
            "tealOrange",
            "filmGrain",
            "dramatic",
            "moody",
            "noir",
            "dreamy",
            "goldenHour",
            "pastel",
            "matte",
            "faded",
            "softFocus",
            "mono",
            "bw",
            "classic",
            "silver",
            "nineties",
            "oldFilm",
            "polaroid",
            "retroFade"
          ]
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "clipIds",
        "preset"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "add_transition",
    "description": "Add a transition on the cut between two touching clips of the same track (fromClipId ends where toClipId starts).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "fromClipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "toClipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "type": "string",
          "enum": [
            "crossfade",
            "dipBlack",
            "dipWhite",
            "wipeLeft",
            "wipeRight",
            "wipeUp",
            "wipeDown",
            "slideLeft",
            "slideRight",
            "pushLeft",
            "pushRight",
            "zoomIn",
            "zoomOut",
            "blur"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3
        }
      },
      "required": [
        "fromClipId",
        "toClipId",
        "kind"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "animate",
    "description": "Animate a clip with keyframes at timeline times. Values: x, y, scale, rotation, opacity, volume, and for text text.size; shapes shape.width/shape.height. Ease: linear, easeIn, easeOut, easeInOut (default), hold.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "keyframes": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "ease": {
                "type": "string",
                "enum": [
                  "linear",
                  "easeIn",
                  "easeOut",
                  "easeInOut",
                  "hold"
                ]
              }
            },
            "required": [
              "time",
              "values"
            ]
          }
        }
      },
      "required": [
        "clipId",
        "keyframes"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "clear_keyframes",
    "description": "Remove a clip's animation, keeping the values it has at its start.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "clipId"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "list_templates",
    "description": "Ready-made titles, intros, lower thirds and outros that insert_template can add.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "insert_template",
    "description": "Insert a template at `start` on new graphics tracks on top. Its placeholder text can then be changed with update_clip.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "start": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "persian": {
          "default": false,
          "description": "Use the Persian placeholder text, laid out right-to-left",
          "type": "boolean"
        }
      },
      "required": [
        "templateId"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "list_library",
    "description": "Files in the server's library: stickers, sounds (sound effects and music), overlays (light leaks, dust) or backgrounds.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "stickers",
            "sounds",
            "overlays",
            "backgrounds"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "add_library_item",
    "description": "Add a library file (see list_library) to the project and the timeline at `start`. Backgrounds go on the bottom video track.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "stickers",
            "sounds",
            "overlays",
            "backgrounds"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "start": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "required": [
        "kind",
        "path"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "list_cues",
    "description": "The cues (start, end, text) of a subtitle track, or of the first one.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "add_subtitles",
    "description": "Create a subtitle track from cues you write or from SRT/WebVTT text. Use it for scripted captions; auto_captions transcribes the audio instead.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "language": {
          "default": "en",
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "cues": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "end": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "text": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "start",
              "end",
              "text"
            ]
          }
        },
        "srt": {
          "description": "SRT or WebVTT file text, instead of cues",
          "type": "string",
          "maxLength": 500000
        }
      }
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "edit_cues",
    "description": "Change, add or delete subtitle cues. Changes: {cueId, text?, start?, end?}; additions: {trackId, start, end, text}; deletions: cue ids.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "change": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cueId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "start": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "end": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              }
            },
            "required": [
              "cueId"
            ]
          }
        },
        "add": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trackId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "start": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "end": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "text": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "trackId",
              "start",
              "end",
              "text"
            ]
          }
        },
        "delete": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "auto_captions",
    "description": "Transcribe the speech in the project into a new subtitle track, in the browser with Whisper. Takes from seconds to minutes: poll job_status. Model: base is fast, large-v3-turbo is best (needs a strong computer).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "model": {
          "default": "base",
          "type": "string",
          "enum": [
            "tiny",
            "base",
            "small",
            "large-v3-turbo"
          ]
        },
        "language": {
          "description": "e.g. fa, en; omitted: detected",
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        }
      }
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "translate_captions",
    "description": "Translate an English subtitle track into a new Persian one, in the browser (Pro plan). Poll job_status.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quality": {
          "default": "standard",
          "type": "string",
          "enum": [
            "standard",
            "precise"
          ]
        }
      },
      "required": [
        "trackId"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "snapshot",
    "description": "A picture of the video at timeline time `time` (also moves the playhead there). Use it to check how an edit looks.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "maxSize": {
          "default": 640,
          "type": "integer",
          "minimum": 160,
          "maximum": 1280
        }
      },
      "required": [
        "time"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "job_status",
    "description": "Progress of auto_captions, translate_captions and export.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "request_export",
    "description": "Open the export window with these settings. The user must press Export themselves (the browser asks where to save). Free accounts: up to 60 s and a watermark. Poll job_status.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "format": {
          "default": "mp4",
          "type": "string",
          "enum": [
            "mp4",
            "mov",
            "webm",
            "avi",
            "mp3",
            "gif",
            "png",
            "jpg"
          ]
        },
        "resolution": {
          "anyOf": [
            {
              "type": "number",
              "const": 240
            },
            {
              "type": "number",
              "const": 360
            },
            {
              "type": "number",
              "const": 480
            },
            {
              "type": "number",
              "const": 720
            },
            {
              "type": "number",
              "const": 1080
            }
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "burnSubtitles": {
          "type": "boolean"
        }
      }
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "undo",
    "description": "Undo the last change (the agent’s or the user’s).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "redo",
    "description": "Redo the last undone change.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": false
    }
  }
]
