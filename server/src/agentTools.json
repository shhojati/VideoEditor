[
  {
    "name": "get_project",
    "description": "The open project: settings, length, playhead, every track (bottom to top) with its clips, and subtitle tracks. Call this first and after edits to get ids. Times are seconds.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "list_assets",
    "description": "Media in the project (videos, sounds, pictures) with ids for add_clip. The user imports files; an agent can only add library items (add_library_item).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "get_clip",
    "description": "Every setting of one clip (transform, text, shape, audio, effects with params, keyframes).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "clipId"
      ]
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "add_clip",
    "description": "Put an asset on the timeline at `start`. Without trackId it goes on the top free track that takes it (or a new one). Optional inPoint (seconds into the source) and duration trim it.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "inPoint": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "assetId",
        "start"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "add_text",
    "description": "Add a text clip (title, caption, label) on a graphics track. Defaults: 3 s, white bold 72 px Vazirmatn with a black outline, slightly below centre. Persian/Arabic text is detected and laid out right-to-left.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "fontFamily": {
          "type": "string",
          "maxLength": 100
        },
        "fontSize": {
          "type": "number",
          "minimum": 4,
          "maximum": 1000,
          "description": "Pixels in project resolution"
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "strokeColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "bgColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "animIn": {
          "type": "string",
          "enum": [
            "fade",
            "slideUp",
            "slideDown",
            "slideLeft",
            "slideRight",
            "pop",
            "zoom",
            "typewriter",
            "wordByWord",
            "blurIn",
            "wipe"
          ]
        },
        "animOut": {
          "type": "string",
          "enum": [
            "fade",
            "slideUp",
            "slideDown",
            "slideLeft",
            "slideRight",
            "pop",
            "zoom",
            "typewriter",
            "wordByWord",
            "blurIn",
            "wipe"
          ]
        },
        "start": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "transform": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": -2,
              "maximum": 2,
              "description": "Centre offset as a fraction of the frame width: 0 centred, -0.5 left edge, 0.5 right edge"
            },
            "y": {
              "type": "number",
              "minimum": -2,
              "maximum": 2,
              "description": "Centre offset as a fraction of the frame height: 0 centred, -0.5 top, 0.5 bottom"
            },
            "scale": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20
            },
            "rotation": {
              "type": "number",
              "minimum": -3600,
              "maximum": 3600,
              "description": "Degrees, clockwise"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "required": [
        "content"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "add_shape",
    "description": "Add a vector shape (rectangle, circle, star, line…) on a graphics track. Sizes are project pixels.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "fill": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "kind": {
          "type": "string",
          "enum": [
            "rectangle",
            "square",
            "circle",
            "oval",
            "triangle",
            "star",
            "polygon",
            "line"
          ]
        },
        "start": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "transform": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": -2,
              "maximum": 2,
              "description": "Centre offset as a fraction of the frame width: 0 centred, -0.5 left edge, 0.5 right edge"
            },
            "y": {
              "type": "number",
              "minimum": -2,
              "maximum": 2,
              "description": "Centre offset as a fraction of the frame height: 0 centred, -0.5 top, 0.5 bottom"
            },
            "scale": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20
            },
            "rotation": {
              "type": "number",
              "minimum": -3600,
              "maximum": 3600,
              "description": "Degrees, clockwise"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "required": [
        "kind"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "add_solid",
    "description": "Add a full-frame solid colour layer (a background or a colour wash) on a graphics track.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "start": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "color"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "update_clip",
    "description": "Change a clip: length, transform (position/scale/rotation/opacity), blend mode, sound (volume 0..2, fades), text style or shape style. On a clip with keyframes, transform and volume changes land in a keyframe at `time` (default the clip start).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transform": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": -2,
              "maximum": 2,
              "description": "Centre offset as a fraction of the frame width: 0 centred, -0.5 left edge, 0.5 right edge"
            },
            "y": {
              "type": "number",
              "minimum": -2,
              "maximum": 2,
              "description": "Centre offset as a fraction of the frame height: 0 centred, -0.5 top, 0.5 bottom"
            },
            "scale": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20
            },
            "rotation": {
              "type": "number",
              "minimum": -3600,
              "maximum": 3600,
              "description": "Degrees, clockwise"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "blend": {
          "type": "string",
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "softLight",
            "hardLight",
            "darken",
            "lighten",
            "add",
            "difference",
            "color",
            "luminosity"
          ]
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "text": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "fontFamily": {
              "type": "string",
              "maxLength": 100
            },
            "fontSize": {
              "type": "number",
              "minimum": 4,
              "maximum": 1000,
              "description": "Pixels in project resolution"
            },
            "fontWeight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "strokeColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "bgColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "align": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "animIn": {
              "type": "string",
              "enum": [
                "fade",
                "slideUp",
                "slideDown",
                "slideLeft",
                "slideRight",
                "pop",
                "zoom",
                "typewriter",
                "wordByWord",
                "blurIn",
                "wipe"
              ]
            },
            "animOut": {
              "type": "string",
              "enum": [
                "fade",
                "slideUp",
                "slideDown",
                "slideLeft",
                "slideRight",
                "pop",
                "zoom",
                "typewriter",
                "wordByWord",
                "blurIn",
                "wipe"
              ]
            }
          }
        },
        "shape": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            "height": {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "stroke": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0,
              "maximum": 500
            },
            "cornerRadius": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            }
          }
        },
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "required": [
        "clipId"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "move_clip",
    "description": "Move a clip to a new start time, optionally onto another track of the same kind. Fails if it would overlap another clip.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "clipId",
        "start"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "trim_clip",
    "description": "Move a clip's start or end edge to timeline time `time` (clamped to the source media and neighbouring clips).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "edge": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        },
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "required": [
        "clipId",
        "edge",
        "time"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "split",
    "description": "Cut clips in two at timeline time `time`: the given clips, or every clip under that time on unlocked tracks. Returns the ids of the new right-hand parts.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "clipIds": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "required": [
        "time"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "delete_clips",
    "description": "Delete clips. With ripple, later clips on the same track move left to close the gap.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipIds": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "ripple": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "clipIds"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "set_speed",
    "description": "Play a video or sound clip faster or slower (0.1 to 10; 2 = twice as fast). The clip gets shorter or longer on the timeline.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        }
      },
      "required": [
        "clipId",
        "speed"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "detach_audio",
    "description": "Move the sound of video clips onto their own clips on an audio track (the video goes silent).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipIds": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "required": [
        "clipIds"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "list_effects",
    "description": "Effects (with their parameters and ranges), filter presets and transition kinds that can be added.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "add_effect",
    "description": "Add an effect (blur, glow, colour correction…; see list_effects) to visual clips, with optional parameter values.",
