{
  "name": "video-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "dev:api": "node --watch server/src/index.ts --dev",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api": "node --test \"server/src/*.test.ts\"",
    "test:watch": "vitest",
    "typecheck": "tsc -p . && tsc -p server",
    "lint": "eslint .",
    "format": "prettier --write src",
    "e2e": "playwright test",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "ci": "npm run lint && npm run typecheck && npm test && npm run test:api && npm run e2e && npm run e2e:prod"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/markazi-text": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@mediabunny/aac-encoder": "^1.61.6",
    "@mediabunny/mp3-encoder": "^1.62.0",
    "i18next": "^26.5.3",
    "idb": "^8.0.4",
    "immer": "^11.1.21",
    "mediabunny": "^1.61.6",
    "perfect-freehand": "1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "vazirmatn": "^33.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
