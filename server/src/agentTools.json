            "gaussianBlur",
            "fastBoxBlur",
            "cameraLensBlur",
            "directionalBlur",
            "sharpen",
            "unsharpMask",
            "lumetri",
            "curves",
            "levels",
            "hueSaturation",
            "tint",
            "tritone",
            "brightnessContrast",
            "transform",
            "turbulentDisplace",
            "displacementMap",
            "opticsCompensation",
            "powerPin",
            "fill",
            "gradientRamp",
            "fourColorGradient",
            "grid",
            "lensFlare",
            "stroke",
            "glow",
            "dropShadow",
            "motionTile",
            "roughenEdges",
            "findEdges",
            "posterize",
            "mosaic",
            "bevelAlpha",
            "sphere",
            "echo",
            "posterizeTime",
            "particleWorld",
            "particleSystems",
            "keylight",
            "linearColorKey",
            "colorRange",
            "linearWipe",
            "radialWipe",
            "venetianBlinds",
            "blockDissolve",
            "gradientWipe",
            "colorWheels"
          ]
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "clipIds",
        "kind"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "update_effect",
    "description": "Change an effect's parameters, turn it on or off, or remove it.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "effectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "remove": {
          "type": "boolean"
        }
      },
      "required": [
        "clipId",
        "effectId"
      ]
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "set_filter",
